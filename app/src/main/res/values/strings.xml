    <string name="about">About</string>
    <string name="about_text">Rootlings is a field guide to the spirits of your real houseplants. No account, no ads, no analytics: plants, photos and notes stay on the phone.</string>
    <string name="credits">Font m6x11 by Daniel Linssen, Cyrillic by Natto Games. Weather: Open-Meteo.com and MET Norway (CC BY 4.0). Care data is general advice; every home is different.</string>
    <string name="windows">Windows</string>
    <string name="windows_intro">Which way a window looks decides how much sun reaches the sill. Press the phone\'s back to the glass and let the compass tell, or pick by hand.</string>
    <string name="window_plants">plants: %1$d</string>
    <string name="window_name">Window name (kitchen, bedroom…)</string>
    <string name="window_faces">It looks out to</string>
